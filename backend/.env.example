# ==================== 数据库配置 (必填) ====================
# Docker: docker-compose up -d postgres
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://bidmind:your_secure_password@localhost:5432/bidmind_lite

# 文件存储路径
UPLOAD_DIR=./storage/uploads
CHUNK_DIR=./storage/chunks

# LLM推理服务配置
# Ollama (Windows/Mac): http://localhost:11434/v1
# vLLM (Linux): http://localhost:8001/v1
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b

# 向量模型 (本地路径或HuggingFace名称)
# 本地: ../models/bge-m3
# 在线: BAAI/bge-m3
EMBEDDING_MODEL=../models/bge-m3
# 向量化设备: cpu / cuda / auto (推荐auto，自动检测GPU)
EMBEDDING_DEVICE=auto

# ==================== 安全配置 (生产环境必填) ====================
# JWT密钥: 生产环境必须设置随机安全密钥（不设置则非DEBUG模式拒绝启动）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# 初始管理员密码: 首次启动自动创建管理员账户（不设置则非DEBUG模式拒绝启动）
ADMIN_PASSWORD=replace-with-a-long-random-password

# 运行环境: development / production
# production 下自动关闭 /docs、/redoc、/openapi.json，并拒绝 CORS 通配符
ENVIRONMENT=development

# CORS允许域名: 逗号分隔，开发环境 http://localhost:3000
# production 环境禁止为空或包含通配符 '*'（与 allow_credentials 冲突）
CORS_ORIGINS=http://localhost:3000

# 认证/上传入口 IP 维度限流（slowapi 语法，留空字符串表示不限流）
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/minute

# ==================== Redis / ARQ 配置 (可选) ====================
# Redis 连接配置（用于任务队列和心跳持久化）
# 本地开发: docker compose up -d redis
# 不配置时自动回退到 asyncio 内存模式
REDIS_HOST=localhost
REDIS_PORT=6379

# ARQ 开关: 三条件生效 (此开关=true + Redis 可用 + worker alive 心跳新鲜)
# 只开启此开关不会立即走 ARQ, 还需启动 worker 进程: cd backend && arq app.worker.WorkerSettings
# 默认 false 保持 asyncio 后台任务; 本地/生产需灰度开启时设为 true
VECTOR_PREFER_ARQ=false

# ARQ Worker 心跳窗口 (单位: 秒)
# TTL 必须 >= FRESHNESS_WINDOW, INTERVAL 必须 < FRESHNESS_WINDOW
# 窗口须盖住进程内合法堵塞 (encode/OCR 120s)，短于此时存活键过期会被当成 worker 消失
ARQ_WORKER_HEARTBEAT_TTL=180
ARQ_WORKER_HEARTBEAT_INTERVAL=15
ARQ_WORKER_FRESHNESS_WINDOW=180

# 任务级心跳超时: vector_job_states.last_heartbeat_at 超过该窗口未推进, 视为卡死
# 大文件处理可能单批次就超过 180s, 如触发误恢复可适度上调
ARQ_JOB_HEARTBEAT_TIMEOUT=180

# Worker 资源调度: 默认保持单队列兼容, 通过 Redis 许可限制重资源并发
WORKER_RESOURCE_PERMIT_ENABLED=true
WORKER_RESOURCE_QUEUES_ENABLED=false
WORKER_TARGET_RUNNING_TASKS=5
WORKER_RESOURCE_UTILIZATION_TARGET=0.8
WORKER_WAIT_BEFORE_FALLBACK_SEC=30
WORKER_WAIT_POLL_INTERVAL=2
WORKER_EVENT_LOOP_LAG_WARN_MS=5000
WORKER_DRAIN_TIMEOUT_SEC=15
WORKER_DEFAULT_MAX_JOBS=5
WORKER_PROCESS_MAX_JOBS=5
WORKER_LLM_MAX_JOBS=5
WORKER_REPORT_MAX_JOBS=3
WORKER_MAINTENANCE_MAX_JOBS=1

# 项目级公平调度: 让 WORKER_TARGET_RUNNING_TASKS 真正生效, 防止单个项目独占全部槽位
# 两个开关置 false 即完整退回旧 FIFO 行为 (不影响资源许可与自适应并发)
WORKER_PROJECT_FAIRNESS_ENABLED=true
AI_PROJECT_FAIR_QUEUE_ENABLED=true

# 生产环境由 docker-compose.prod.yml 默认 false; 本文件面向开发, 保留 true 供本机无 worker 时使用
BACKGROUND_FALLBACK_ENABLED=true
BACKGROUND_FALLBACK_MAX_JOBS=1


# ==================== 邮箱验证 / 反多账号 ====================
# 硬拦截总开关：关闭维持旧行为；开启后新用户必须验证邮箱才能登录，试用改为验证后发放
# （存量用户迁移已豁免）。开启前请先配好 SMTP，否则用户收不到验证邮件。
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
# 忘记密码: 重置令牌有效期(分钟); 该功能只要配好 SMTP 即可用, 与上面的验证开关无关
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# 前端基址，用于拼接验证链接 {FRONTEND_BASE_URL}/verify-email?token=...
FRONTEND_BASE_URL=https://your-domain.example.com
# 一次性邮箱域名补充（逗号分隔，追加到内置黑名单）
DISPOSABLE_EMAIL_EXTRA=
# SMTP 发信（用于邮箱验证）；host/user/password 任一为空则不发信（仅记录日志）
# 阿里云邮件推送 SMTP 示例：SMTP_HOST=smtpdm.aliyun.com SMTP_PORT=465 SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BidMind
SMTP_USE_SSL=true
SMTP_USE_TLS=false


# 应用配置
LOG_LEVEL=INFO

# 审查配置
REVIEW_MAX_RETRIES=3
REVIEW_BATCH_SIZE=5

# 文档处理并发配置
DOC_PROCESS_CONCURRENCY=3   # 同时处理文档数上限（建议2-4，视CPU核数调整）
PARSE_THREAD_WORKERS=3      # PDF解析进程池大小（变量名沿用）
# 招标要求提取 ARQ 防呆超时（秒）。大文档需高于 LLM 队列默认 1800s，避免健康任务被墙钟误杀。
WORKER_EXTRACT_JOB_TIMEOUT=3600

# ==================== 云端 AI 配置 (可选) ====================
# AI模式: local=本地模型, cloud=云端模型
AI_MODE=local

# 云端API配置 (使用云端模式时需要配置)
# 支持的服务: OpenAI, DeepSeek, 智谱AI, 通义千问, Moonshot, SiliconFlow
CLOUD_API_BASE=https://api.deepseek.com
CLOUD_API_KEY=your_api_key_here
CLOUD_MODEL_NAME=deepseek-chat

# ==================== L3 完整候选提取配置 (Task-2) ====================
# 运行模式: off=关闭, shadow=影子对比(当前安全默认), enforce=强制执行
SCORING_FULL_CANDIDATE_MODE=shadow
# 上下文字符预算（必须 >0）
SCORING_FULL_CANDIDATE_CONTEXT_CHAR_BUDGET=24000
# 最大输出 token 数（必须 >0）
SCORING_FULL_CANDIDATE_MAX_TOKENS=5000
# 每侧邻近 chunk 数限制（>=0，0=不含邻居）
SCORING_FULL_CANDIDATE_NEIGHBOR_CHUNKS=2
# 单次请求最大 scope 数量（必须 >0）
SCORING_FULL_CANDIDATE_MAX_SCOPES=3
# L3 调用超时秒数（必须 >0）
SCORING_FULL_CANDIDATE_TIMEOUT_S=180.0

# ==================== 评分候选事务 (Task6-13) ====================
# 运行模式: off=不读证据/不调用LLM/不写报告, shadow=完整评估但仍返回legacy
# items(仅附带脱敏candidate_report), enforce=全局adopted才返回candidate
# items(失败返回空items且只持久化问题报告)。非法值运行时回退shadow。
# enforce 会把候选事务失败放大为整档零产出，禁止默认 enforce。
# 该链路已换轴至账本(ledger)并进入冻结待删清单, shadow 产出不参与业务
# 数据但占用关键路径(实测单文档 24.5 分钟), 冻结期一律 off。
SCORING_CANDIDATE_TRANSACTION_MODE=off
