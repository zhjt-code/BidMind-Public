{# 人员表模板 (B5.7) — 输入: items: list[dict], title: str #}
<table>
<thead>
<tr><th>序号</th><th>姓名</th><th>职务/职称</th><th>学历</th><th>专业</th><th>工作年限</th><th>拟担任角色</th></tr>
</thead>
<tbody>
{% for item in items %}
<tr>
<td>{{ loop.index }}</td>
<td>{{ item.name | default("", true) }}</td>
<td>{{ item.title | default("", true) }}</td>
<td>{{ item.education | default("", true) }}</td>
<td>{{ item.major | default("", true) }}</td>
<td>{{ item.experience_years | default("", true) }}</td>
<td>{{ item.role | default("", true) }}</td>
</tr>
{% endfor %}
</tbody>
</table>
