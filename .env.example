# docker-compose.prod.yml 的生产环境示例。
# 复制为 .env 后替换所有 change-me 值；不要提交 .env。

ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://bidmind:change-me@postgres-host:5432/bidmind
JWT_SECRET_KEY=change-me-generate-at-least-32-random-bytes
ADMIN_PASSWORD=change-me-use-a-long-unique-password
AI_SETTINGS_KEY=change-me-generate-a-separate-random-key

# 逗号分隔的真实 HTTPS 前端源；生产环境不得为空或使用 *。
CORS_ORIGINS=https://bid.example.com
FRONTEND_BASE_URL=https://bid.example.com

AI_MODE=local
VECTOR_PREFER_ARQ=true
BACKGROUND_FALLBACK_ENABLED=false

# 默认使用官方镜像和 PyTorch index；仅在明确需要时配置镜像前缀或 wheel 目录。
REGISTRY=
TORCH_FIND_LINKS=

# 生产 Compose 默认使用 5 个 OCR 和 3 个 structure 实例，可按服务器资源缩减。
OCR_SERVICE_URLS=http://ocr-1:9000,http://ocr-2:9000,http://ocr-3:9000,http://ocr-4:9000,http://ocr-5:9000
DOCUMENT_QA_STRUCTURE_URLS=http://structure-1:9000,http://structure-2:9000,http://structure-3:9000
STRUCTURE_CPUS=4

# 可选邮件验证；开启前填写 SMTP_*。
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BidMind
SMTP_USE_SSL=true
SMTP_USE_TLS=false
